{
  "manifest_version": 3,
  "name": "Entry External Runner",
  "version": "0.3.1",
  "description": "EntryJS external runner",
  "permissions": [],
  "host_permissions": [
    "https://playentry.org/*"
  ],
  "action": {
    "default_title": "Entry External Runner",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/ws/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://playentry.org/ws/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
